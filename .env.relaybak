# ====================================================================
# .env para sa OMNIPOS — ilagay ito sa loob ng ~/OMNIPOS/ folder mo sa
# Termux, at PALITAN ANG PANGALAN papunta sa ".env" (may tuldok sa una,
# walang laman bago ang tuldok). Awtomatiko na itong babasahin ng
# server.js sa susunod na pag-start (dahil sa process.loadEnvFile() na
# idinagdag na natin).
# ====================================================================

# URL ng RELAY mo. Dahil pareho lang silang tumatakbo sa parehong
# device/Termux session (localhost), ito ang tamang value:
RELAY_URL=https://relay-spwy.onrender.comm

# TINUGMA ito sa RELAY_API_KEY na nasa RELAY/.env mo — kailangang
# EKSAKTONG magkatugma ang dalawang value na ito, kung hindi, tatanggihan
# ng RELAY ang mga request (403 Invalid API key).
RELAY_API_KEY=7756e54ec45c9e10dcdc678c459dae35e7dbe8ba0509cb03

# ----------------------------------------------------------------
# PAALALA: ito ang parehong "TESTING value" na ginamit mo habang
# nagsusubok sa Termux — gumagana ito ngayon dahil magkatugma ang
# dalawang panig (RELAY at OMNIPOS). Pero BAGO mo talaga ibenta/i-deploy
# ito sa isang totoong kliyente, gumawa ng SARILI at BAGONG random value
# (parehong ilalagay sa RELAY/.env AT dito), halimbawa sa pamamagitan ng:
#
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
#
# tapos i-restart PAREHONG RELAY at OMNIPOS pagkatapos baguhin.
# ----------------------------------------------------------------

# ----------------------------------------------------------------
# AUTO-BACKUP TOGGLE (TESTING PHASE)
# "false" = naka-bypass/naka-off ang auto-backup (walang bagong .db files
#          na ise-schedule sa database/backups/ tuwing 30s-startup at
#          bawat 24 oras) — gamitin ito habang nasa TESTING pa.
# Pagbebentahan/deployment na sa totoong kliyente: burahin na lang ang
# linyang ito (o palitan ng "false"), tapos i-restart ang server —
# awtomatikong babalik ang normal na auto-backup schedule, walang
# kailangang baguhin pa sa server.js.
DISABLE_AUTO_BACKUP=true
# ----------------------------------------------------------------

# ----------------------------------------------------------------
# PRODUCT IMAGE SEARCH (opsyonal — "Search Image" button sa Add/Edit
# Product form). Walang built-in image search API ang OMNIPOS, kaya
# SARILI mong API key ang gagamitin dito, kapareho ng RELAY_API_KEY
# sa itaas. Kung iiwan mong BLANK ito, gagana pa rin ang buong system
# — "Choose from Gallery" / "Take Photo" lang, walang "Search Image"
# button (magpapakita na lang ng malinaw na mensahe kung pinindot).
#
# 1) Piliin ang PROVIDER (isa lang): google | bing | serpapi
IMAGE_SEARCH_PROVIDER=serpapi
#
# 2) Ilagay ang API key ng piniling provider:
#    - google:  Google Custom Search JSON API key
#    - bing:    Bing Image Search (Azure Cognitive Services) key
#    - serpapi: SerpAPI key — ang PINAKAMADALING i-setup: mag-sign up
#               lang sa https://serpapi.com/users/sign_up, tapos kunin
#               ang "Your Private API Key" sa Dashboard. Isang key lang,
#               walang ibang kailangang i-configure (di gaya ng Google
#               na may hiwalay pang CX/Search Engine setup).
IMAGE_SEARCH_API_KEY=b2e5036ab7339d771b0a8f1f7e945d89ae2dd942f8e79eb04cb75e57de42c46d
#
# 3) KAILANGAN LANG kung provider=google — ang Custom Search Engine ID
#    (cx) mo, naka-set na "Image search: ON" at "Search the entire web".
IMAGE_SEARCH_CX=
#
# Tandaan: SafeSearch/safe=active ay palaging naka-ON sa lahat ng
# provider (hardcoded sa server.js), at ang lahat ng hanap ay
# nangangailangan pa rin ng manual review/pagpili ng user bago ito
# ma-save sa produkto.
# ----------------------------------------------------------------

# ----------------------------------------------------------------
# AI ASSISTANT (bagong "ai_assistant" module subscription — advanced na
# AI help assistant sa loob ng FAQ page).
#
# BAGO: HINDI na dito nakatira ang Cloudflare Workers AI credentials
# (CF_ACCOUNT_ID / CF_AI_API_TOKEN / CF_AI_MODEL). Dating naka-embed ito
# dito at kasama sa naka-encrypt na .env sa loob ng bawat
# omnipos-client.zip — pero dahil ang decryption key nito (.env.key) ay
# kasabay ding kasama sa parehong package, madali itong ma-access ng
# end customer mismo (parehong Cloudflare account/token ng developer,
# ginagamit ng LAHAT ng client install).
#
# Ngayon, ang mga ito ay inilipat sa RELAY/.env (server ng developer
# lang) — tumatawag na lang ang OMNIPOS client sa isang proxy endpoint
# doon (/relay/ai-assistant/complete) gamit ang parehong
# RELAY_URL/RELAY_API_KEY sa itaas, kaya hindi na kailangang (o puwedeng)
# makita ng kliyente ang mismong Cloudflare token. Walang ibang
# kailangang baguhin dito — gagana ito basta naka-configure ang
# CF_ACCOUNT_ID/CF_AI_API_TOKEN sa RELAY/.env, at may RELAY_API_KEY at
# RELAY_URL naman dito.
# ----------------------------------------------------------------
